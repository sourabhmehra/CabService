# --- LOCAL DEVELOPMENT ---
# Leave empty (Next.js rewrites /api/* to http://127.0.0.1:8000 automatically).
NEXT_PUBLIC_API_BASE=

# --- PRODUCTION (Vercel) ---
# Set this to your Render backend URL in Vercel → Settings → Environment Variables.
# Example:
# NEXT_PUBLIC_API_BASE=https://mehra-travels-api.onrender.com
